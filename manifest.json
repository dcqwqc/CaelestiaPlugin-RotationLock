{
  "name": "TabletMode",
  "version": "1.1.1",
  "author": "dcqwqc",
  "homepage": "https://github.com/dcqwqc/CaelestiaPlugin-TabletMode",
  "icon": "tablet_android",
  "description": "Convertible laptop support for Caelestia: tablet mode, sensor auto-rotation, on-screen keyboard, and integrated Rotation Lock.",
  "entryPoints": [
    {
      "type": "custom",
      "source": "Main.qml"
    },
    {
      "type": "quick-toggle",
      "source": "toggles/RotationLockToggle.qml",
      "properties": {
        "name": "rotationLock"
      }
    }
  ],
  "settings": "Settings.qml"
}
