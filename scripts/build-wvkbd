#!/usr/bin/env bash
# Build the exact wvkbd source tracked by this plugin and install only the
# plugin-owned binary in the current user's local bin directory.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
plugin_root="$(cd -- "${script_dir}/.." && pwd -P)"
source_dir="${plugin_root}/vendor/wvkbd"
target_dir="$(python3 -c 'from pathlib import Path; print(Path.home() / ".local" / "bin")')"
target_bin="${target_dir}/wvkbd-mobintl"

if [[ ! -f "${source_dir}/Makefile" || ! -f "${source_dir}/UPSTREAM.md" ]]; then
    printf '%s\n' "TabletMode wvkbd source is incomplete: ${source_dir}" >&2
    exit 1
fi

for tool in cc make pkg-config wayland-scanner scdoc install; do
    command -v "${tool}" >/dev/null || {
        printf '%s\n' "Required build tool is missing: ${tool}" >&2
        exit 1
    }
done

pkg-config --exists wayland-client xkbcommon pangocairo || {
    printf '%s\n' 'Missing wvkbd development packages: wayland-client, xkbcommon, pangocairo.' >&2
    exit 1
}

cleanup() {
    make -C "${source_dir}" LAYOUT=mobintl clean >/dev/null 2>&1 || true
}
trap cleanup EXIT

make -C "${source_dir}" LAYOUT=mobintl
mkdir -p -- "${target_dir}"
install -m 0755 -- "${source_dir}/wvkbd-mobintl" "${target_bin}"
printf '%s\n' "Installed ${target_bin}"
